{% extends 'tema-new/layout-base.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {{ include('tema-new/include/page-header.html.twig', {title: titolo|trans, actions: [
    {label: 'label.add'|trans, url: path('alunni_classe_edit'), title: 'Nuovo cambio classe di un alunno'},
    {label: 'label.alunno_inserito'|trans, url: path('alunni_classe_edit', {id: 0, tipo: 'I'}), title: 'Nuovo inserimento di un alunno', class: 'btn-outline-primary', icon: 'user-plus'},
    {label: 'label.alunno_trasferito'|trans, url: path('alunni_classe_edit', {id: 0, tipo: 'T'}), title: 'Nuovo trasferimento di un alunno', class: 'btn-outline-primary', icon: 'exchange-alt'},
    {label: 'label.alunno_cambio_sezione'|trans, url: path('alunni_classe_edit', {id: 0, tipo: 'S'}), title: 'Nuovo cambio di sezione di un alunno', class: 'btn-outline-primary', icon: 'exchange-alt'}
  ]}) }}
  {{ include('tema-new/include/filtro.html.twig', {form: form[0]}) }}
  <div class="table-responsive">
    <table class="table table-bordered table-hover table-striped table-sm gs-data-table">
      <thead class="table-light">
        <tr>
          <th class="col-auto" scope="col">{{ 'label.alunno'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.classe'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.data_inizio'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.data_fine'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.note'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.action'|trans }}</th>
        </tr>
      </thead>
      <tbody>
  {% for c in dati.lista %}
        <tr>
          <td><small>{{ c.cognome }} {{ c.nome }} ({{ c.dataNascita|date('d/m/Y') }})</small></td>
          <td><small>{{ c.anno ? c.anno~'ª '~c.sezione~(c.gruppo ? ('-'~c.gruppo)) }}</small></td>
          <td><small>{{ c.cambio.inizio|date('d/m/Y') }}</small></td>
          <td><small>{{ c.cambio.fine|date('d/m/Y') }}</small></td>
          <td><small>{{ c.cambio.note }}</small></td>
          <td class="pb-0">
            <a class="btn btn-primary btn-xs me-1 mb-1" href="{{ path('alunni_classe_edit', {'id': c.cambio.id}) }}" role="button" title="Modifica i dati del cambio classe">{{ 'label.edit'|trans }}</a>
            <a class="btn btn-danger btn-xs me-1 mb-1" href="{{ path('alunni_classe_delete', {'id': c.cambio.id}) }}" role="button" title="Cancella i dati del cambio classe">{{ 'label.delete'|trans }}</a>
          </td>
        </tr>
  {% endfor %}
      </tbody>
    </table>
  </div>
  {{ include('tema-new/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'alunni_classe'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
<script>
$(document).ready(function() {
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('alunni_classe') }}/"+p;
    return false;
  });
});
</script>
{% endblock %}
