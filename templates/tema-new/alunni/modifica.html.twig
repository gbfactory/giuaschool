{% extends 'tema-new/layout-base.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {{ include('tema-new/include/page-header.html.twig', {title: titolo|trans, actions: [
    {label: 'label.add'|trans, url: path('alunni_modifica_edit'), title: 'Nuovo utente'},
    {label: 'label.pdf_password'|trans, url: path('alunni_passwordFiltro', {genitore: 0}), title: 'Scarica le nuove password degli alunni', class: 'btn-outline-primary', icon: 'file-pdf'},
    {label: 'label.pdf_password_genitore'|trans, url: path('alunni_passwordFiltro', {genitore: 1}), title: 'Scarica le nuove password dei genitori', class: 'btn-outline-primary', icon: 'file-pdf'}
  ]}) }}
  {{ include('tema-new/include/filtro.html.twig', {form: form[0]}) }}
  <div class="table-responsive gs-user-table-wrapper">
    <table class="table table-bordered table-hover table-sm gs-data-table gs-user-table">
      <thead class="table-light">
        <tr>
          <th class="col-auto" scope="col">{{ 'label.username'|trans }}</th>
          <th class="col-auto" scope="col">Nome e cognome</th>
          <th class="col-auto" scope="col">{{ 'label.email'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.codice_fiscale'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.abilitato'|trans }}</th>
          <th class="col-auto" scope="col">SPID/CIE</th>
          <th class="col-auto" scope="col">{{ 'label.ultimo_accesso'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.action'|trans }}</th>
        </tr>
      </thead>
      <tbody>
  {% for a in dati.lista %}
        <tr{% if not a.abilitato %} class="gs-user-row--disabled"{% endif %}>
          <td data-label="Username"><code>{{ a.username }}</code></td>
          <td data-label="Nome e cognome"><strong>{{ a.nome }} {{ a.cognome }}</strong></td>
          <td class="gs-user-email" data-label="Email">{{ a.email ?: '—' }}</td>
          <td data-label="Codice fiscale">{{ a.codiceFiscale ?: '—' }}</td>
          <td data-label="Abilitato">
            <span class="gs-status-badge {{ a.abilitato ? 'gs-status-badge--yes' : 'gs-status-badge--no' }}">{{ a.abilitato ? 'Sì' : 'No' }}</span>
          </td>
          <td data-label="SPID/CIE">
            <span class="gs-status-badge {{ a.spid ? 'gs-status-badge--yes' : 'gs-status-badge--no' }}">{{ a.spid ? 'Sì' : 'No' }}</span>
          </td>
          <td data-label="Ultimo accesso">{{ a.ultimoAccesso ? (a.ultimoAccesso|date('d/m/Y')) : 'Mai' }}</td>
          <td class="gs-user-table__actions" data-label="Azioni">
            <div class="gs-row-actions">
              <a class="btn btn-primary btn-sm gs-row-actions__primary" href="{{ path('alunni_modifica_edit', {'id': a.id}) }}">{{ 'label.edit'|trans }}</a>
              <div class="dropdown">
                <button class="btn btn-outline-primary btn-sm dropdown-toggle" id="gs-actions-alunno-{{ a.id }}" type="button" data-bs-toggle="dropdown" aria-expanded="false">Altre azioni</button>
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="gs-actions-alunno-{{ a.id }}">
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-info-{{ a.id }}">{{ 'label.show'|trans }}</button>
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="Nuova password per {{ a.nome }} {{ a.cognome }}" data-contenuto="La password attuale verrà invalidata e quella nuova sarà inviata via email. Vuoi continuare?" data-href="{{ path('alunni_password', {'username': a.username, 'tipo': 'E'}) }}">{{ 'label.email_password'|trans }}</button>
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="Nuova password per {{ a.nome }} {{ a.cognome }}" data-contenuto="La password attuale verrà invalidata e quella nuova sarà scaricata in PDF. Vuoi continuare?" data-href="{{ path('alunni_password', {'username': a.username, 'tipo': 'P'}) }}">{{ 'label.pdf_password'|trans }}</button>
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-scelta-genitore" title="Genera una nuova password per il genitore e la invia tramite email"
              data-title="Scegli il genitore a cui inviare la password"
              data-button1="{{ (dati.genitori[a.id][0].email and dati.genitori[a.id][0].email[-6:] != '.local') ? 'Invia' }}"
              data-gen1="{{ dati.genitori[a.id][0].nome }} {{ dati.genitori[a.id][0].cognome }} ({{ dati.genitori[a.id][0].username }})" data-email1="{{ (dati.genitori[a.id][0].email and dati.genitori[a.id][0].email[-6:] != '.local') ? (': '~dati.genitori[a.id][0].email) }}"
              data-href1="{{ path('alunni_password', {'username': dati.genitori[a.id][0].username, 'tipo': 'E'}) }}"
              data-button2="{{ (dati.genitori[a.id][1].email and dati.genitori[a.id][1].email[-6:] != '.local') ? 'Invia' }}"
              data-gen2="{{ dati.genitori[a.id][1].nome }} {{ dati.genitori[a.id][1].cognome }} ({{ dati.genitori[a.id][1].username }})" data-email2="{{ (dati.genitori[a.id][1].email and dati.genitori[a.id][1].email[-6:] != '.local') ? (': '~dati.genitori[a.id][1].email) }}"
              data-href2="{{ path('alunni_password', {'username': dati.genitori[a.id][1].username, 'tipo': 'E'}) }}">{{ 'label.email_password_genitore'|trans }}</button>
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-scelta-genitore" title="Genera una nuova password per il genitore e la scarica come documento PDF"
              data-title="Scegli il genitore di cui scaricare la password"
              data-button1="Scarica"
              data-gen1="{{ dati.genitori[a.id][0].nome }} {{ dati.genitori[a.id][0].cognome }} ({{ dati.genitori[a.id][0].username }})" data-email1=""
              data-href1="{{ path('alunni_password', {'username': dati.genitori[a.id][0].username, 'tipo': 'P'}) }}"
              data-button2="Scarica"
              data-gen2="{{ dati.genitori[a.id][1].nome }} {{ dati.genitori[a.id][1].cognome }} ({{ dati.genitori[a.id][1].username }})" data-email2=""
              data-href2="{{ path('alunni_password', {'username': dati.genitori[a.id][1].username, 'tipo': 'P'}) }}">{{ 'label.pdf_password_genitore'|trans }}</button>
                  <div class="dropdown-divider"></div>
    {% if a.abilitato %}
                  <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="Disabilita {{ a.nome }} {{ a.cognome }}" data-contenuto="L'utente non potrà più accedere finché non verrà riabilitato. Vuoi continuare?" data-href="{{ path('alunni_abilita', {'id': a.id, 'abilita': 0}) }}" data-variante="danger">{{ 'label.disable'|trans }}</button>
    {% else %}
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="Abilita {{ a.nome }} {{ a.cognome }}" data-contenuto="L'utente potrà nuovamente accedere. Vuoi continuare?" data-href="{{ path('alunni_abilita', {'id': a.id, 'abilita': 1}) }}">{{ 'label.enable'|trans }}</button>
    {% endif %}
                </div>
              </div>
            </div>
            <div class="modal fade" id="gs-info-{{ a.id }}" tabindex="-1" aria-labelledby="gs-info-{{ a.id }}-titolo" aria-hidden="true">
              <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                  <div class="modal-header border-bottom">
                    <div>
                      <h5 class="modal-title" id="gs-info-{{ a.id }}-titolo">{{ a.cognome }} {{ a.nome }}</h5>
                      <ul class="nav nav-tabs nav-tabs-cards" role="tablist">
                        <li class="nav-item">
                          <a class="nav-link active" id="gs-alunno-{{ a.id }}-tab" data-bs-toggle="pill" href="#gs-alunno-{{ a.id }}" role="tab" aria-controls="gs-alunno-{{ a.id }}" aria-selected="true"><strong>Alunno</strong></a>
                        </li>
                        <li class="nav-item">
                          <a class="nav-link" id="gs-genitore1-{{ a.id }}-tab" data-bs-toggle="pill" href="#gs-genitore1-{{ a.id }}" role="tab" aria-controls="gs-genitore1-{{ a.id }}" aria-selected="false"><strong>Genitore 1</strong></a>
                        </li>
                        <li class="nav-item">
                          <a class="nav-link" id="gs-genitore2-{{ a.id }}-tab" data-bs-toggle="pill" href="#gs-genitore2-{{ a.id }}" role="tab" aria-controls="gs-genitore2-{{ a.id }}" aria-selected="false"><strong>Genitore 2</strong></a>
                        </li>
                      </ul>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'label.close'|trans }}"></button>
                  </div>
                  <div class="modal-body">
                    <div class="tab-content">
                      <div class="tab-pane fade show active" id="gs-alunno-{{ a.id }}" role="tabpanel" aria-labelledby="gs-alunno-{{ a.id }}-tab">
                        <dl class="row">
                          <dt class="col-sm-2 text-end">{{ 'label.nome'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.nome }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.cognome'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.cognome }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.sesso'|trans }}</dt>
                          <dd class="col-sm-4">{{ (a.sesso == 'M' ? 'label.maschile' : 'label.femminile')|trans }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.data_nascita'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.dataNascita|date('d/m/Y') }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.comune_nascita'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.comuneNascita }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.provincia_nascita'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.provinciaNascita }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.codice_fiscale'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.codiceFiscale }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.citta'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.citta }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.provincia'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.provincia }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.indirizzo'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.indirizzo }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.religione'|trans }}</dt>
                          <dd class="col-sm-4">{{ ('label.religione_'~a.religione)|trans }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.bes'|trans }}</dt>
                          <dd class="col-sm-4">{{ ('label.bes_'~a.bes)|trans }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.note_bes'|trans }}</dt>
                          <dd class="col-sm-10">{{ a.noteBes|raw }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.credito3'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.credito3 }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.credito4'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.credito4 }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.classe'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.classe }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.frequenza_estero'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.frequenzaEstero ? 'Si' : 'No' }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.username'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.username }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.email'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.email }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.spid'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.spid ? 'Si' : 'No' }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.ultimo_accesso'|trans }}</dt>
                          <dd class="col-sm-4">{{ a.ultimoAccesso ? (a.ultimoAccesso|date('d/m/Y H:i:s')) : 'NESSUNO' }}</dd>
                        </dl>
                      </div>
                      <div class="tab-pane fade" id="gs-genitore1-{{ a.id }}" role="tabpanel" aria-labelledby="gs-genitore1-{{ a.id }}-tab">
                        <dl class="row">
                          <dt class="col-sm-2 text-end">{{ 'label.nome'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][0].nome }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.cognome'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][0].cognome }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.codice_fiscale'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][0].codiceFiscale }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.numeri_telefono'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][0].numeriTelefono|join(', ') }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.spid'|trans }}</dt>
                          <dd class="col-sm-10">{{ dati.genitori[a.id][0].spid ? 'Si' : 'No' }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.username'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][0].username }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.email'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][0].email }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.ultimo_accesso'|trans }}</dt>
                          <dd class="col-sm-10">{{ dati.genitori[a.id][0].ultimoAccesso ? (dati.genitori[a.id][0].ultimoAccesso|date('d/m/Y H:i:s')) : 'NESSUNO' }}</dd>
                        </dl>
                      </div>
                      <div class="tab-pane fade" id="gs-genitore2-{{ a.id }}" role="tabpanel" aria-labelledby="gs-genitore2-{{ a.id }}-tab">
                        <dl class="row">
                          <dt class="col-sm-2 text-end">{{ 'label.nome'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][1].nome }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.cognome'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][1].cognome }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.codice_fiscale'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][1].codiceFiscale }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.numeri_telefono'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][1].numeriTelefono|join(', ') }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.spid'|trans }}</dt>
                          <dd class="col-sm-10">{{ dati.genitori[a.id][1].spid ? 'Si' : 'No' }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.username'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][1].username }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.email'|trans }}</dt>
                          <dd class="col-sm-4">{{ dati.genitori[a.id][1].email }}</dd>
                          <dt class="col-sm-2 text-end">{{ 'label.ultimo_accesso'|trans }}</dt>
                          <dd class="col-sm-10">{{ dati.genitori[a.id][1].ultimoAccesso ? (dati.genitori[a.id][1].ultimoAccesso|date('d/m/Y H:i:s')) : 'NESSUNO' }}</dd>
                        </dl>
                      </div>
                    </div>
                  </div>
                  <div class="modal-footer mx-auto">
                    <button type="button" class="btn btn-primary btn-xs mx-auto" data-bs-dismiss="modal">{{ 'label.close'|trans }}</button>
                  </div>
                </div>
              </div>
            </div>
          </td>
        </tr>
  {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="modal fade" id="gs-scelta-genitore" tabindex="-1" aria-labelledby="gs-scelta-genitore-titolo" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header border-bottom">
          <h5 class="modal-title" id="gs-scelta-genitore-titolo"></h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'label.close'|trans }}"></button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-sm-10 mb-2"><strong id="gs-scelta-genitore-1"></strong><span id="gs-scelta-genitore-1-email"></span></div>
            <div class="col-sm-2 mb-2"><a id="gs-scelta-genitore-1-href" class="btn btn-primary btn-xs" href="" role="button"><strong></strong></a></div>
            <div class="col-sm-10"><strong id="gs-scelta-genitore-2"></strong><span id="gs-scelta-genitore-2-email"></span></div>
            <div class="col-sm-2"><a id="gs-scelta-genitore-2-href" class="btn btn-primary btn-xs" href="" role="button"><strong></strong></a></div>
          </div>
        </div>
        <div class="modal-footer mx-auto">
          <button type="button" class="btn btn-secondary btn-xs mx-auto" data-bs-dismiss="modal">{{ 'label.cancel'|trans }}</button>
        </div>
      </div>
    </div>
  </div>
  {{ include('tema-new/include/modal-confirm.html.twig') }}
  {{ include('tema-new/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'alunni_modifica'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
<script>
$(document).ready(function() {
  document.getElementById('gs-scelta-genitore').addEventListener('show.bs.modal', function (e) {
    var title = $(e.relatedTarget).data('title');
    var button1 = $(e.relatedTarget).data('button1');
    var gen1 = $(e.relatedTarget).data('gen1');
    var email1 = $(e.relatedTarget).data('email1');
    var href1 = $(e.relatedTarget).data('href1');
    var button2 = $(e.relatedTarget).data('button2');
    var gen2 = $(e.relatedTarget).data('gen2');
    var email2 = $(e.relatedTarget).data('email2');
    var href2 = $(e.relatedTarget).data('href2');
    $(this).find('#gs-scelta-genitore-titolo').text(title);
    if (button1) {
      $('#gs-scelta-genitore-1-href').show();
      $('#gs-scelta-genitore-1-href strong').text(button1);
    } else {
      $('#gs-scelta-genitore-1-href').hide();
    }
    if (button2) {
      $('#gs-scelta-genitore-2-href').show();
      $('#gs-scelta-genitore-2-href strong').text(button2);
    } else {
      $('#gs-scelta-genitore-2-href').hide();
    }
    $(this).find('#gs-scelta-genitore-1').text(gen1);
    $(this).find('#gs-scelta-genitore-1-email').text(email1);
    $(this).find('#gs-scelta-genitore-1-href').attr('href', href1);
    $(this).find('#gs-scelta-genitore-2').text(gen2);
    $(this).find('#gs-scelta-genitore-2-email').text(email2);
    $(this).find('#gs-scelta-genitore-2-href').attr('href', href2);
  });
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('alunni_modifica') }}/"+p;
    return false;
  });
});
</script>
{% endblock %}
