{% extends 'tema-new/layout-base.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {{ include('tema-new/include/page-header.html.twig', {title: titolo|trans, actions: [{label: 'label.add'|trans, url: path('ata_modifica_edit'), title: 'Nuovo utente'}]}) }}
  {{ include('tema-new/include/filtro.html.twig', {form: form[0]}) }}
  <div class="table-responsive gs-user-table-wrapper">
    <table class="table table-bordered table-hover table-sm gs-data-table gs-user-table">
      <thead class="table-light">
        <tr>
          <th class="col-auto" scope="col">{{ 'label.username'|trans }}</th>
          <th class="col-auto" scope="col">Nome e cognome</th>
          <th class="col-auto" scope="col">{{ 'label.email'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.codice_fiscale'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.abilitato'|trans }}</th>
          <th class="col-auto" scope="col">SPID/CIE</th>
          <th class="col-auto" scope="col">{{ 'label.ultimo_accesso'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.action'|trans }}</th>
        </tr>
      </thead>
      <tbody>
  {% for u in dati.lista %}
        <tr{% if not u.abilitato %} class="gs-user-row--disabled"{% endif %}>
          <td data-label="Username"><code>{{ u.username }}</code></td>
          <td data-label="Nome e cognome"><strong>{{ u.nome }} {{ u.cognome }}</strong></td>
          <td class="gs-user-email" data-label="Email">{{ u.email ?: '—' }}</td>
          <td data-label="Codice fiscale">{{ u.codiceFiscale ?: '—' }}</td>
          <td data-label="Abilitato">
            <span class="gs-status-badge {{ u.abilitato ? 'gs-status-badge--yes' : 'gs-status-badge--no' }}">{{ u.abilitato ? 'Sì' : 'No' }}</span>
          </td>
          <td data-label="SPID/CIE">
            <span class="gs-status-badge {{ u.spid ? 'gs-status-badge--yes' : 'gs-status-badge--no' }}">{{ u.spid ? 'Sì' : 'No' }}</span>
          </td>
          <td data-label="Ultimo accesso">{{ u.ultimoAccesso ? (u.ultimoAccesso|date('d/m/Y')) : 'Mai' }}</td>
          <td class="gs-user-table__actions" data-label="Azioni">
            <div class="gs-row-actions">
              <a class="btn btn-primary btn-sm gs-row-actions__primary" href="{{ path('ata_modifica_edit', {'id': u.id}) }}">{{ 'label.edit'|trans }}</a>
              <div class="dropdown">
                <button class="btn btn-outline-primary btn-sm dropdown-toggle" id="gs-actions-ata-{{ u.id }}" type="button" data-bs-toggle="dropdown" aria-expanded="false">Altre azioni</button>
                <div class="dropdown-menu dropdown-menu-end" aria-labelledby="gs-actions-ata-{{ u.id }}">
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-modal-info" data-titolo="{{ u.cognome }} {{ u.nome }}" data-cont-id="info-utente-{{ u.id }}">{{ 'label.show'|trans }}</button>
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="Nuova password per {{ u.nome }} {{ u.cognome }}" data-contenuto="La password attuale verrà invalidata e quella nuova sarà inviata via email. Vuoi continuare?" data-href="{{ path('ata_password', {'id': u.id, 'tipo': 'E'}) }}">{{ 'label.email_password'|trans }}</button>
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="Nuova password per {{ u.nome }} {{ u.cognome }}" data-contenuto="La password attuale verrà invalidata e quella nuova sarà scaricata in PDF. Vuoi continuare?" data-href="{{ path('ata_password', {'id': u.id, 'tipo': 'P'}) }}">{{ 'label.pdf_password'|trans }}</button>
                  <div class="dropdown-divider"></div>
    {% if u.abilitato %}
                  <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="Disabilita {{ u.nome }} {{ u.cognome }}" data-contenuto="L'utente non potrà più accedere finché non verrà riabilitato. Vuoi continuare?" data-href="{{ path('ata_abilita', {'id': u.id, 'abilita': 0}) }}" data-variante="danger">{{ 'label.disable'|trans }}</button>
    {% else %}
                  <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="Abilita {{ u.nome }} {{ u.cognome }}" data-contenuto="L'utente potrà nuovamente accedere. Vuoi continuare?" data-href="{{ path('ata_abilita', {'id': u.id, 'abilita': 1}) }}">{{ 'label.enable'|trans }}</button>
    {% endif %}
                </div>
              </div>
            </div>
            <div class="d-none" id="info-utente-{{ u.id }}">
              <dl class="row">
                <dt class="col-sm-2 text-end">{{ 'label.nome'|trans }}</dt>
                <dd class="col-sm-4">{{ u.nome }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.cognome'|trans }}</dt>
                <dd class="col-sm-4">{{ u.cognome }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.sesso'|trans }}</dt>
                <dd class="col-sm-4">{{ (u.sesso == 'M' ? 'label.maschile' : 'label.femminile')|trans }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.codice_fiscale'|trans }}</dt>
                <dd class="col-sm-4">{{ u.codiceFiscale }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.ata_tipo'|trans }}</dt>
                <dd class="col-sm-4">{{ ('label.ata_tipo_'~u.tipo)|trans }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.ata_segreteria'|trans }}</dt>
                <dd class="col-sm-4">{{ (u.segreteria ? 'label.si' : 'label.no')|trans }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.sede'|trans }}</dt>
                <dd class="col-sm-4">{{ u.sede }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.spid'|trans }}</dt>
                <dd class="col-sm-4">{{ u.spid ? 'Si' : 'No' }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.username'|trans }}</dt>
                <dd class="col-sm-4">{{ u.username }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.email'|trans }}</dt>
                <dd class="col-sm-4">{{ u.email }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.ultimo_accesso'|trans }}</dt>
                <dd class="col-sm-4">{{ u.ultimoAccesso ? (u.ultimoAccesso|date('d/m/Y H:i:s')) : 'NESSUNO' }}</dd>
              </dl>
            </div>
          </td>
        </tr>
  {% endfor %}
      </tbody>
    </table>
  </div>
  {{ include('tema-new/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'ata_modifica'}) }}
  {{ include('tema-new/include/modal-info.html.twig') }}
  {{ include('tema-new/include/modal-confirm.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
<script>
$(document).ready(function() {
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('ata_modifica') }}/"+p;
    return false;
  });
  document.getElementById('gs-modal-info').addEventListener('show.bs.modal', function (e) {
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $('#'+$(e.relatedTarget).data('cont-id')).html();
    $(this).find('#gs-modal-info-titolo').html(titolo);
    $(this).find('#gs-modal-info-contenuto').html(contenuto);
  });
});
</script>
{% endblock %}
