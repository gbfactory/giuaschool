{% set page_route = app.request.attributes.get('_route') %}

{% macro icon(name, extra_class) %}
{% if name %}
  <svg class="icon icon-sm {{ extra_class|default('') }}" aria-hidden="true">
    <use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#{{ name }}"></use>
  </svg>
{% endif %}
{% endmacro %}

{% macro item(opt, route, level) %}
{% if opt.nome == '__SEPARATORE__' %}
  <li class="gs-sidebar-separator" role="separator"></li>
{% else %}
  <li class="gs-sidebar-item gs-sidebar-item--level-{{ level|default(1) }}">
{% if opt.abilitato %}
    <a class="gs-sidebar-link{{ route == opt.url ? ' active' }}" href="{{ opt.url ? path(opt.url) : '#' }}" title="{{ opt.descrizione|raw }}"{{ route == opt.url ? ' aria-current="page"' }}>
      {{ _self.icon(opt.icona, '') }}
      <span>{{ opt.nome|raw }}</span>
{% if route == opt.url %}
      <span class="visually-hidden">, pagina attiva</span>
{% endif %}
    </a>
{% else %}
    <span class="gs-sidebar-link disabled" title="{{ opt.descrizione|raw }}" aria-disabled="true">
      {{ _self.icon(opt.icona, '') }}
      <span>{{ opt.nome|raw }}</span>
    </span>
{% endif %}
  </li>
{% endif %}
{% endmacro %}

{% macro group(opt, route, index, level) %}
{% set is_active = opt.listaurl and route in opt.listaurl %}
{% set group_id = 'gs-sidebar-group-'~level~'-'~index %}
  <li class="gs-sidebar-group{{ is_active ? ' active' }}">
    <button class="gs-sidebar-group-toggle{{ is_active ? ' active' }}" type="button" aria-expanded="{{ is_active ? 'true' : 'false' }}" aria-controls="{{ group_id }}" data-gs-sidebar-group>
      {{ _self.icon(opt.icona, '') }}
      <span>{{ opt.nome|raw }}</span>
      <svg class="icon icon-xs gs-sidebar-chevron" aria-hidden="true">
        <use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#chevron-down"></use>
      </svg>
    </button>
    <ul id="{{ group_id }}" class="gs-sidebar-submenu"{{ not is_active ? ' hidden' }}>
{% for subopt in opt.sottomenu %}
{% if subopt.sottomenu %}
      {{ _self.group(subopt, route, index~'-'~loop.index, level + 1) }}
{% else %}
      {{ _self.item(subopt, route, level + 1) }}
{% endif %}
{% endfor %}
    </ul>
  </li>
{% endmacro %}

<nav class="gs-sidebar-nav" aria-label="{{ app.session.get('/CONFIG/MENU/main').nome|raw }}">
  <div class="gs-sidebar-label">Amministrazione</div>
  <ul class="gs-sidebar-menu">
{% for opt in app.session.get('/CONFIG/MENU/main').opzioni %}
{% if opt.sottomenu %}
    {{ _self.group(opt, page_route, loop.index, 1) }}
{% else %}
    {{ _self.item(opt, page_route, 1) }}
{% endif %}
{% endfor %}
  </ul>
</nav>
