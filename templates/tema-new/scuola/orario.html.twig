{% extends 'tema-new/layout-base.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {{ include('tema-new/include/page-header.html.twig', {title: titolo|trans, actions: [{label: 'label.add'|trans, url: path('scuola_orario_edit'), title: 'Nuovo orario'}]}) }}
  {{ include('tema-new/include/flash.html.twig') }}
  <div class="table-responsive">
    <table class="table table-bordered table-hover table-striped table-sm gs-data-table">
      <thead class="table-light">
        <tr>
          <th class="col-auto" scope="col">{{ 'label.nome_orario'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.data_inizio'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.sede'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.action'|trans }}</th>
        </tr>
      </thead>
      <tbody>
  {% for o in dati %}
        <tr>
          <td>{{ o.nome }}</td>
          <td><small>{{ o.inizio|date('d/m/Y') }}</small></td>
          <td><small>{{ o.sede.nomeBreve }}</small></td>
          <td class="pb-0">
            <button type="button" class="btn btn-primary btn-xs me-1 mb-1" title="Mostra i dettagli dell'orario" data-bs-toggle="modal" data-bs-target="#gs-modal-info" data-titolo="{{ o.nome }}" data-cont-id="info-orario-{{ o.id }}">{{ 'label.show'|trans }}</button>
            <a class="btn btn-primary btn-xs me-1 mb-1" href="{{ path('scuola_orario_edit', {'id': o.id}) }}" role="button" title="Modifica i dati dell'orario">{{ 'label.edit'|trans }}</a>
            <button type="button" class="btn btn-danger btn-xs me-1 mb-1 gs-modal-confirm-button" title="Cancella l'orario" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="{{ o.nome }}" data-contenuto="{{ 'message.cancella_orario'|trans }}" data-href="{{ path('scuola_orario_delete', {'id': o.id}) }}">{{ 'label.delete'|trans }}</button>
            <a class="btn btn-primary btn-xs me-1 mb-1" href="{{ path('scuola_orario_scansione', {'id': o.id}) }}" role="button" title="Modifica la scansione oraria">{{ 'label.scansione_oraria'|trans }}</a>
            <div class="d-none" id="info-orario-{{ o.id }}">
              <dl class="row">
                <dt class="col-sm-2 text-end">{{ 'label.nome_orario'|trans }}</dt>
                <dd class="col-sm-10">{{ o.nome }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.data_inizio'|trans }}</dt>
                <dd class="col-sm-4">{{ o.inizio|date('d/m/Y') }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.data_fine'|trans }}</dt>
                <dd class="col-sm-4">{{ o.fine|date('d/m/Y') }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.sede'|trans }}</dt>
                <dd class="col-sm-10">{{ o.sede.nome }}</dd>
              </dl>
            </div>
          </td>
        </tr>
  {% endfor %}
      </tbody>
    </table>
  </div>
  {{ include('tema-new/include/modal-info.html.twig') }}
  {{ include('tema-new/include/modal-confirm.html.twig') }}
</div>
{% endblock %}

{% block pagina_js_fine %}
<script>
$(document).ready(function() {
  document.getElementById('gs-modal-info').addEventListener('show.bs.modal', function (e) {
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $('#'+$(e.relatedTarget).data('cont-id')).html();
    $(this).find('#gs-modal-info-titolo').html(titolo);
    $(this).find('#gs-modal-info-contenuto').html(contenuto);
  });
  document.getElementById('gs-modal-confirm').addEventListener('show.bs.modal', function (e) {
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $(e.relatedTarget).data('contenuto');
    var href = $(e.relatedTarget).data('href');
    $(this).find('#gs-modal-confirm-titolo').html(titolo);
    $(this).find('#gs-modal-confirm-contenuto').html(contenuto);
    $(this).find('#gs-modal-confirm-yes').attr('href', href);
  });
});
</script>
{% endblock %}
