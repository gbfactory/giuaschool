{% extends 'tema-new/layout-base.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {{ include('tema-new/include/page-header.html.twig', {title: titolo|trans, actions: [{label: 'label.add'|trans, url: path('scuola_festivita_edit'), title: 'Nuova festività'}]}) }}
  {{ include('tema-new/include/flash.html.twig') }}
  <div class="table-responsive">
    <table class="table table-bordered table-hover table-striped table-sm gs-data-table">
      <thead class="table-light">
        <tr>
          <th class="col-auto" scope="col">{{ 'label.data'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.descrizione'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.action'|trans }}</th>
        </tr>
      </thead>
      <tbody>
  {% for f in dati.lista %}
        <tr>
          <td>{{ f.data|date('d/m/Y') }}</td>
          <td><small>{{ f.descrizione }}</small></td>
          <td class="pb-0">
            <button type="button" class="btn btn-primary btn-xs me-1 mb-1" title="Mostra i dettagli della festività" data-bs-toggle="modal" data-bs-target="#gs-modal-info" data-titolo="{{ f.data|date('d/m/Y') }}" data-cont-id="info-festivita-{{ f.id }}">{{ 'label.show'|trans }}</button>
            <a class="btn btn-primary btn-xs me-1 mb-1" href="{{ path('scuola_festivita_edit', {'id': f.id}) }}" role="button" title="Modifica i dati della festività">{{ 'label.edit'|trans }}</a>
            <button type="button" class="btn btn-danger btn-xs me-1 mb-1 gs-modal-confirm-button" title="Cancella la festività" data-bs-toggle="modal" data-bs-target="#gs-modal-confirm" data-titolo="{{ f.data|date('d/m/Y') }}" data-contenuto="{{ 'message.cancella_festivita'|trans }}" data-href="{{ path('scuola_festivita_delete', {'id': f.id}) }}">{{ 'label.delete'|trans }}</button>
            <div class="d-none" id="info-festivita-{{ f.id }}">
              <dl class="row">
                <dt class="col-sm-2 text-end">{{ 'label.data'|trans }}</dt>
                <dd class="col-sm-10">{{ f.data|date('d/m/Y') }}</dd>
                <dt class="col-sm-2 text-end">{{ 'label.descrizione'|trans }}</dt>
                <dd class="col-sm-10">{{ f.descrizione }}</dd>
              </dl>
            </div>
          </td>
        </tr>
  {% endfor %}
      </tbody>
    </table>
  </div>
  {{ include('tema-new/include/modal-info.html.twig') }}
  {{ include('tema-new/include/modal-confirm.html.twig') }}
  {{ include('tema-new/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'scuola_festivita'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
<script>
$(document).ready(function() {
  document.getElementById('gs-modal-info').addEventListener('show.bs.modal', function (e) {
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $('#'+$(e.relatedTarget).data('cont-id')).html();
    $(this).find('#gs-modal-info-titolo').html(titolo);
    $(this).find('#gs-modal-info-contenuto').html(contenuto);
  });
  document.getElementById('gs-modal-confirm').addEventListener('show.bs.modal', function (e) {
    var titolo = $(e.relatedTarget).data('titolo');
    var contenuto = $(e.relatedTarget).data('contenuto');
    var href = $(e.relatedTarget).data('href');
    $(this).find('#gs-modal-confirm-titolo').html(titolo);
    $(this).find('#gs-modal-confirm-contenuto').html(contenuto);
    $(this).find('#gs-modal-confirm-yes').attr('href', href);
  });
});
</script>
{% endblock %}
