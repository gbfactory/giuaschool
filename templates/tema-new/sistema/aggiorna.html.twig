{% extends 'tema-new/layout-base.html.twig' %}

{% block pagina_contenuto %}
<div class="container">
  {{ include('tema-new/include/page-header.html.twig', {title: titolo|trans}) }}
  <div class="alert alert-{{ info.tipo }} text-center gs-big">
    <strong>{{ (info.messaggio|trans(dati))|raw }}</strong>
  </div>
  {% if info.prossimo > info.step %}
  <div class="text-center">
    <a class="btn btn-primary" href="{{ path('sistema_aggiorna', {step: info.prossimo}) }}" role="button" title="Continua la procedura di aggiornamento"><strong>{{ 'label.continua'|trans }}</strong></a>
  </div>
  {% endif %}
</div>
{% endblock %}
