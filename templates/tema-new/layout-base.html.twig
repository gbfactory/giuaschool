<!doctype html>
<html dir="ltr" lang="it">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="keywords" content="scuola,registro,elettronico,{{ app.session.get('/CONFIG/ISTITUTO/intestazione')|replace({' ': ','})|lower }}{% for ks in 0 .. (app.session.get('/CONFIG/ISTITUTO/num_sedi')-1) %},{{ app.session.get('/CONFIG/ISTITUTO/sede_'~ks~'_citta')|lower }}{% endfor %}">
    <meta name="description" content="giua@school: il registro elettronico dell'{{ app.session.get('/CONFIG/ISTITUTO/intestazione') }}">
    <meta name="author" content="Antonello Dessì">
    <title>{{ pagina_titolo|trans }}</title>
    <link href="{{ asset('vendor/bootstrap-italia-2.18.3/css/bootstrap-italia.min.css') }}" rel="stylesheet">
    <link href="{{ asset('css/main.css?v='~(filedate('css/main.css')|date('U'))) }}" rel="stylesheet">
    <link href="{{ asset('css/admin.css?v='~(filedate('css/admin.css')|date('U'))) }}" rel="stylesheet">
{% block pagina_css %}
{% endblock %}
{% block pagina_js_inizio %}
{% endblock %}
    <link rel="apple-touch-icon" sizes="180x180" href="{{ asset('apple-icon-180x180.png') }}">
    <link rel="apple-touch-icon" sizes="152x152" href="{{ asset('apple-icon-152x152.png') }}">
    <link rel="apple-touch-icon" sizes="144x144" href="{{ asset('apple-icon-144x144.png') }}">
    <link rel="apple-touch-icon" sizes="120x120" href="{{ asset('apple-icon-120x120.png') }}">
    <link rel="apple-touch-icon" sizes="114x114" href="{{ asset('apple-icon-114x114.png') }}">
    <link rel="apple-touch-icon" sizes="76x76" href="{{ asset('apple-icon-76x76.png') }}">
    <link rel="apple-touch-icon" sizes="72x72" href="{{ asset('apple-icon-72x72.png') }}">
    <link rel="apple-touch-icon" sizes="60x60" href="{{ asset('apple-icon-60x60.png') }}">
    <link rel="apple-touch-icon" sizes="57x57" href="{{ asset('apple-icon-57x57.png') }}">
    <link rel="icon" type="image/png" sizes="192x192" href="{{ asset('android-icon-192x192.png') }}">
    <link rel="icon" type="image/png" sizes="96x96" href="{{ asset('favicon-96x96.png') }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('favicon-32x32.png') }}">
    <link rel="icon" type="image/png" sizes="16x16" href="{{ asset('favicon-16x16.png') }}">
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">
    <link rel="manifest" href="{{ asset('manifest.json') }}">
    <meta name="msapplication-TileColor" content="#0066CC">
    <meta name="msapplication-TileImage" content="{{ asset('ms-icon-144x144.png') }}">
    <meta name="theme-color" content="#004080">
    <meta name="msapplication-config" content="{{ asset('browserconfig.xml') }}">
    <link rel="mask-icon" href="{{ asset('safari-pinned-tab.svg') }}" color="#0066CC">
  </head>
  <body class="gs-admin">
    <div class="skiplinks">
      <a class="visually-hidden-focusable" href="#gs-main">Vai al contenuto</a>
      <a class="visually-hidden-focusable" href="#gs-footer">Vai a fine pagina</a>
    </div>

    <header id="gs-header" class="gs-admin-header">
      <div class="gs-admin-header__inner">
{% if is_granted('IS_AUTHENTICATED_FULLY') %}
        <button id="gs-sidebar-toggle" class="gs-icon-button gs-admin-header__menu" type="button" aria-controls="gs-sidebar" aria-expanded="false" aria-label="Apri il menu principale">
          <svg class="icon icon-sm icon-light" aria-hidden="true">
            <use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#bars"></use>
          </svg>
        </button>
{% endif %}
        <a class="gs-admin-brand" href="{{ is_granted('IS_AUTHENTICATED_FULLY') ? path('login_home') : '#' }}" title="Pagina principale">
          <span class="gs-admin-brand__institution">{{ app.session.get('/CONFIG/ISTITUTO/intestazione_breve') }}</span>
          <span class="gs-admin-brand__product">giua@school</span>
        </a>
        <span class="gs-admin-year d-none d-md-inline">A.S. {{ app.session.get('/CONFIG/SCUOLA/anno_scolastico') }}</span>

        <div class="gs-admin-header__actions">
{% if is_granted('IS_AUTHENTICATED_FULLY') %}
          <div class="dropdown">
            <button id="gs-help-menu-button" class="gs-header-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <svg class="icon icon-sm icon-light" aria-hidden="true">
                <use xlink:href="{{ asset('vendor/fontawesome/sprites/regular.svg') }}#question-circle"></use>
              </svg>
              <span class="d-none d-lg-inline">{{ app.session.get('/CONFIG/MENU/help').nome }}</span>
            </button>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="gs-help-menu-button">
{% for o in app.session.get('/CONFIG/MENU/help').opzioni %}
              <a class="dropdown-item" href="{{ o.url ? path(o.url) : '#' }}" title="{{ o.descrizione|raw }}">{{ o.nome|raw }}</a>
{% endfor %}
            </div>
          </div>

          <div class="dropdown">
            <button id="gs-user-menu-button" class="gs-header-action dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <span class="gs-user-avatar" aria-hidden="true">
                <svg class="icon icon-sm icon-primary">
                  <use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#user"></use>
                </svg>
              </span>
              <span class="gs-user-summary d-none d-lg-flex">
                <strong>{% if is_granted('ROLE_GENITORE') %}{{ app.user.alunno.nome }} {{ app.user.alunno.cognome }}{% else %}{{ app.user.nome }} {{ app.user.cognome }}{% endif %}</strong>
                <small>{{ ('label.'~app.user.roles[0])|trans }}</small>
              </span>
            </button>
            <div class="dropdown-menu dropdown-menu-end" aria-labelledby="gs-user-menu-button">
              <a class="dropdown-item" href="{{ path('utenti_profilo') }}">
                <svg class="icon icon-xs me-2" aria-hidden="true"><use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#user-edit"></use></svg>
                {{ 'title.modifica_profilo'|trans }}
              </a>
              <div class="dropdown-divider"></div>
{% if is_granted('IS_IMPERSONATOR') %}
              <a class="dropdown-item" href="{{ path('sistema_alias_exit') }}">
                <svg class="icon icon-xs me-2" aria-hidden="true"><use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#sign-out-alt"></use></svg>
                {{ 'label.alias'|trans|upper }}
              </a>
{% else %}
              <a class="dropdown-item" href="{{ path('logout') }}">
                <svg class="icon icon-xs me-2" aria-hidden="true"><use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#sign-out-alt"></use></svg>
                {{ 'label.logout'|trans }}
              </a>
{% endif %}
            </div>
          </div>
{% else %}
          <span class="text-white fw-semibold">Registro elettronico</span>
{% endif %}
        </div>
      </div>
    </header>

    <div class="gs-admin-shell">
{% if is_granted('IS_AUTHENTICATED_FULLY') %}
      <div id="gs-sidebar-overlay" class="gs-sidebar-overlay" hidden></div>
      <aside id="gs-sidebar" class="gs-sidebar" aria-label="Navigazione principale">
        <div class="gs-sidebar__mobile-header">
          <strong>Menu amministrazione</strong>
          <button id="gs-sidebar-close" class="gs-icon-button" type="button" aria-label="Chiudi il menu">
            <svg class="icon icon-sm" aria-hidden="true"><use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#times"></use></svg>
          </button>
        </div>
        {{ include('tema-new/layout-menu.html.twig') }}
        <div class="gs-sidebar__footer">
          <span>Versione {{ app.session.get('/CONFIG/SISTEMA/versione') }}</span>
        </div>
      </aside>
{% endif %}

      <div class="gs-admin-page{{ not is_granted('IS_AUTHENTICATED_FULLY') ? ' gs-admin-page--full' }}">
        <main id="gs-main" class="gs-admin-main">
{% if is_granted('IS_AUTHENTICATED_FULLY') and app.request.attributes.get('_route') != 'login_home' and breadcrumb is defined and breadcrumb %}
          <nav class="gs-breadcrumb" aria-label="Percorso di navigazione">
            <ol class="breadcrumb mb-0">
              <li class="breadcrumb-item"><a href="{{ path('login_home') }}">Home</a><span class="separator">/</span></li>
{% if breadcrumb.nome3 is not null %}
              <li class="breadcrumb-item"><a href="{{ breadcrumb.url3 ? path(breadcrumb.url3) : '#' }}" title="{{ breadcrumb.descrizione3|raw }}">{{ breadcrumb.nome3|raw }}</a><span class="separator">/</span></li>
{% endif %}
{% if breadcrumb.nome2 is not null %}
              <li class="breadcrumb-item"><a href="{{ breadcrumb.url2 ? path(breadcrumb.url2) : '#' }}" title="{{ breadcrumb.descrizione2|raw }}">{{ breadcrumb.nome2|raw }}</a><span class="separator">/</span></li>
{% endif %}
              <li class="breadcrumb-item active" aria-current="page">{{ breadcrumb.nome|raw }}</li>
            </ol>
          </nav>
{% endif %}
{% block pagina_contenuto %}
{% endblock %}
        </main>

        <footer id="gs-footer" class="gs-admin-footer">
          <div>
            <strong>giua@school</strong>
            <span class="d-none d-md-inline"> · Registro elettronico open source</span>
          </div>
          <nav aria-label="Informazioni">
{% for o in app.session.get('/CONFIG/MENU/info').opzioni %}
            <a href="{{ o.url ? path(o.url) : '#' }}" title="{{ o.descrizione|raw }}">{{ o.nome|raw }}</a>
{% endfor %}
          </nav>
        </footer>
      </div>
    </div>

    <a class="back-to-top back-to-top-small shadow" href="#gs-main" data-bs-toggle="backtotop" title="Vai a inizio pagina">
      <svg class="icon icon-light" aria-hidden="true"><use xlink:href="{{ asset('vendor/fontawesome/sprites/solid.svg') }}#arrow-up"></use></svg>
      <span class="visually-hidden">Torna su</span>
    </a>

    <script src="{{ asset('vendor/jquery/jquery.min.js') }}"></script>
    <script src="{{ asset('vendor/bootstrap-italia-2.18.3/js/bootstrap-italia.bundle.min.js') }}"></script>
    <script>bootstrap.loadFonts("{{ asset('vendor/bootstrap-italia-2.18.3/fonts') }}");</script>
    <script src="{{ asset('js/main.js?v='~(filedate('js/main.js')|date('U'))) }}"></script>
{% block pagina_js_fine %}
{% endblock %}
  </body>
</html>
