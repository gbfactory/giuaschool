{### datepicker: vincoli per il campo data nativo ###}
{### parametri: dp_field, dp_disabled, dp_week, dp_min, dp_max ###}
<script>
(function () {
  'use strict';

  var input = document.getElementById('{{ dp_field }}');
  if (!input) {
    return;
  }
  {% if dp_disabled %}input.dataset.gsDateDisabled = JSON.stringify({{ dp_disabled|raw }});{% endif %}
  {% if dp_week %}input.dataset.gsDateDisabledWeekdays = JSON.stringify({{ dp_week|raw }});{% endif %}
  {% if dp_min %}input.dataset.gsDateMin = '{{ dp_min }}';{% endif %}
  {% if dp_max %}input.dataset.gsDateMax = '{{ dp_max }}';{% endif %}
}());
</script>
