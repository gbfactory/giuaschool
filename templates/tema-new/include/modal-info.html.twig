{### modal-info: finestra modale usata per mostrare informazioni sulla stessa pagina ###}
{###    parametri: - ###}
<div class="modal fade" id="gs-modal-info" tabindex="-1" aria-labelledby="gs-modal-info-titolo" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header border-bottom">
        <h5 class="modal-title" id="gs-modal-info-titolo"></h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'label.close'|trans }}"></button>
      </div>
      <div class="modal-body" id="gs-modal-info-contenuto"></div>
      <div class="modal-footer mx-auto">
        <button type="button" class="btn btn-primary btn-xs mx-auto" data-bs-dismiss="modal">{{ 'label.close'|trans }}</button>
      </div>
    </div>
  </div>
</div>
