{% extends 'tema-new/layout-base.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {{ include('tema-new/include/page-header.html.twig', {title: titolo|trans, actions: [{label: 'label.add'|trans, url: path('docenti_rappresentanti_edit', {id: 0}), title: 'Aggiungi un nuovo rappresentante'}]}) }}
  {{ include('tema-new/include/filtro.html.twig', {form: form[0]}) }}
  <div class="table-responsive">
    <table class="table table-bordered table-hover table-striped table-sm gs-data-table">
      <thead class="table-light">
        <tr>
          <th class="col-auto" scope="col">{{ 'label.rappresentante'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.tipo'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.action'|trans }}</th>
        </tr>
      </thead>
      <tbody>
  {% for u in dati.lista %}
        <tr>
          <td><small>{{ u }}</small></td>
          <td><small>{% for r in u.rappresentante %}{{ ('label.rappresentante_'~r)|trans }}{{ not loop.last ? ', ' }}{% endfor %}</small></td>
          <td class="pb-0">
            <a class="btn btn-primary btn-xs me-1 mb-1" href="{{ path('docenti_rappresentanti_edit', {id: u.id}) }}" role="button" title="Modifica i dati del rappresentante">{{ 'label.edit'|trans }}</a>
            <a class="btn btn-danger btn-xs me-1 mb-1" href="{{ path('docenti_rappresentanti_delete', {id: u.id}) }}" role="button" title="Elimina il rappresentante">{{ 'label.delete'|trans }}</a>
          </td>
        </tr>
  {% endfor %}
      </tbody>
    </table>
  </div>
  {{ include('tema-new/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'docenti_rappresentanti'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
<script>
$(document).ready(function() {
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('docenti_rappresentanti') }}/"+p;
    return false;
  });
});
</script>
{% endblock %}
