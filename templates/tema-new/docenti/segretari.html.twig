{% extends 'tema-new/layout-base.html.twig' %}

{% block pagina_contenuto %}
<div class="container-fluid">
  {{ include('tema-new/include/page-header.html.twig', {title: titolo|trans, actions: [{label: 'label.add'|trans, url: path('docenti_segretari_edit', {id: 0}), title: 'Aggiungi un nuovo segretario'}]}) }}
  {{ include('tema-new/include/filtro.html.twig', {form: form[0]}) }}
  <div class="table-responsive">
    <table class="table table-bordered table-hover table-striped table-sm gs-data-table">
      <thead class="table-light">
        <tr>
          <th class="col-auto" scope="col">{{ 'label.cognome'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.nome'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.username'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.sede'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.classe'|trans }}</th>
          <th class="col-auto" scope="col">{{ 'label.action'|trans }}</th>
        </tr>
      </thead>
      <tbody>
  {% for c in dati.lista %}
        <tr>
          <td><small>{{ c.segretario.cognome }}</small></td>
          <td><small>{{ c.segretario.nome }}</small></td>
          <td><small>{{ c.segretario.username }}</small></td>
          <td><small>{{ c.sede.nomeBreve }}</small></td>
          <td><small>{{ c }}</small></td>
          <td class="pb-0">
            <a class="btn btn-primary btn-xs me-1 mb-1" href="{{ path('docenti_segretari_edit', {'id': c.id}) }}" role="button" title="Modifica i dati del segretario">{{ 'label.edit'|trans }}</a>
            <a class="btn btn-danger btn-xs me-1 mb-1" href="{{ path('docenti_segretari_delete', {'id': c.id}) }}" role="button" title="Elimina il segretario">{{ 'label.delete'|trans }}</a>
          </td>
        </tr>
  {% endfor %}
      </tbody>
    </table>
  </div>
  {{ include('tema-new/include/paginazione.html.twig', {maxPagine: dati.maxPagine, pagina: info.pagina, url: 'docenti_segretari'}) }}
</div>
{% endblock %}

{% block pagina_js_fine %}
<script>
$(document).ready(function() {
  $("#gs-paginazione").on("submit", function() {
    var p = $("#jumpToPage").val();
    window.location.href = "{{ path('docenti_segretari') }}/"+p;
    return false;
  });
});
</script>
{% endblock %}
